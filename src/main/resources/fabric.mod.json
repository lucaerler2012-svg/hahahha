  "authors": [
    "EnchantmentPlus contributors"
  ],
  "contact": {
    "homepage": "https://modrinth.com/",
    "sources": "https://github.com/DEIN-NAME/enchantmentplus"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.enchantmentplus.EnchantmentPlusMod"
    ]
  },
  "mixins": [
    "enchantmentplus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
